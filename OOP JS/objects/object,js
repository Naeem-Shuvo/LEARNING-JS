// object = A collection of related properties and/or methods
//                Can represent real world objects (people, products, places)
//                object = {key:value,
//                               function()}

const person1={
    firstname:"nemo",
    lastname:"hoodboy",
    age:20,
    hobbies:["gaming","coding","reading"],
    address:{
        street:"123 main st",
        city:"new york",
        state:"ny"
    },

    //**can use arrow function */
    eat:()=>console.log("eating"),
}
console.log(person1);
console.log(person1.firstname, person1.lastname);
console.log(person1.hobbies);
console.log(person1.address.city);
person1.eat(); //calling method

// another object

const person2={
    firstname:"nayona",
    lastname:"mim",
    age:25,
    hobbies:["dancing","singing","drawing"],
    isEmployed:true,

    //**method */
    sayHello:function(){
        console.log("hello i am " + this.firstname);
    }
}
console.log(person2);
console.log(person2.firstname, person2.lastname);
console.log(person2.hobbies);
console.log(person2.isEmployed);
person2.sayHello(); //calling method
